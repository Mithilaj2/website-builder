# Used when the whole project is uploaded into public_html (document root = project root).
# Every request is routed into public/, so app/, config/, storage/, templates/ etc. can never be
# requested directly (URLs like /templates are builder pages, served by public/index.php).
# Each private folder also has its own "Require all denied" .htaccess as a second layer.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(\.git|composer\.(json|lock)$|README\.md$) - [F,L]
    # QA copies of generated websites are served as real sites (password-protected by generated_websites/.htaccess).
    RewriteRule ^generated_websites/ - [L]
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
