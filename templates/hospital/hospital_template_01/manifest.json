{
  "id": "hospital_template_01",
  "name": "CareLine Health",
  "category": "hospital",
  "version": "1.0.0",
  "description": "A calm, clinical design for hospitals and clinics: deep teal and coral on a soft mint background, Plus Jakarta Sans headings and a heartbeat-line motif. Includes a 24×7 emergency strip, quick-access bar, department tiles, doctor profiles with consultation timings, OPD timings table, health packages and an appointment booking form.",
  "libraries": ["bootstrap", "bootstrap-icons"],
  "features": ["contact"],
  "optional_features": ["payments"],
  "theme": {
    "defaults": {
      "primary": "#0B6E6E", "secondary": "#F0604F", "bg": "#F5FAF9", "text": "#12304A",
      "heading_font": "plus-jakarta-sans", "body_font": "dm-sans", "radius": "14px",
      "button_style": "solid", "header_style": "emergency", "footer_style": "navy"
    },
    "header_styles": { "emergency": "With 24×7 emergency strip", "minimal": "Minimal, no top strip" },
    "footer_styles": { "navy": "Deep navy, four columns", "light": "Light, four columns" }
  },
  "section_types": ["hero", "page_banner", "about", "services", "features", "stats", "testimonials", "gallery", "team", "faq", "cta", "contact", "logos", "rich_text", "process", "pricing", "doctors", "opening_hours", "booking_form"],
  "page_types": {
    "home": { "default_sections": ["hero", "services", "about", "stats", "doctors", "opening_hours", "testimonials", "logos", "cta"] },
    "about": { "default_sections": ["page_banner", "about", "stats", "features", "team", "gallery"] },
    "departments": { "default_sections": ["page_banner", "services", "process", "faq", "cta"] },
    "doctors": { "default_sections": ["page_banner", "doctors", "cta"] },
    "packages": { "default_sections": ["page_banner", "pricing", "faq", "cta"] },
    "appointment": { "default_sections": ["page_banner", "booking_form", "process", "opening_hours"] },
    "contact": { "default_sections": ["page_banner", "contact", "opening_hours"] },
    "legal": { "default_sections": ["page_banner", "rich_text"] },
    "generic": { "default_sections": ["page_banner", "rich_text", "cta"] }
  },
  "default_pages": [
    { "title": "Home", "slug": "", "type": "home", "is_home": true },
    { "title": "About Us", "slug": "about", "type": "about" },
    { "title": "Departments", "slug": "departments", "type": "departments" },
    { "title": "Doctors", "slug": "doctors", "type": "doctors" },
    { "title": "Health Packages", "slug": "health-packages", "type": "packages" },
    { "title": "Book Appointment", "slug": "appointment", "type": "appointment", "in_menu": false },
    { "title": "Contact Us", "slug": "contact", "type": "contact" },
    { "title": "Privacy Policy", "slug": "privacy-policy", "type": "legal", "in_menu": false, "in_footer": true },
    { "title": "Terms and Conditions", "slug": "terms-and-conditions", "type": "legal", "in_menu": false, "in_footer": true }
  ],
  "demo_content": "demo.json"
}
