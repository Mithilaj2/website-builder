{
  "id": "restaurant_template_05",
  "name": "Ember & Oak",
  "category": "restaurant",
  "version": "1.0.0",
  "description": "A moody, refined dark design for fine-dining, tasting-menu and chef-led restaurants: centred masthead, an editorial hero, a menu board with tasting menus, a reservation form, guest-chef events and a private dining room.",
