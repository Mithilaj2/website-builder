{
  "id": "realestate_template_06",
  "name": "HomeHive Rentals",
  "category": "real-estate",
  "version": "1.0.0",
  "description": "A friendly, modern design for rental agencies and property managers: floating navigation, a centred hero with a rental search, image type tiles, cards with rent and a details button, and owner services.",
  "libraries": [
    "bootstrap",
    "bootstrap-icons"
  ],
  "features": [
    "contact"
  ],
  "optional_features": [
    "payments"
  ],
  "theme": {
    "defaults": {
      "primary": "#3730A3",
      "secondary": "#F7B731",
      "bg": "#FFFDF8",
      "text": "#1E1B3A",
      "heading_font": "plus-jakarta-sans",
      "body_font": "inter",
      "radius": "20px",
      "button_style": "pill",
      "header_style": "sticky",
      "footer_style": "dark"
    },
    "header_styles": {
      "sticky": "Sticky",
      "static": "Scrolls with the page"
    },
    "footer_styles": {
      "dark": "Dark",
      "light": "Light"
    }
  },
  "section_types": [
    "hero",
    "page_banner",
    "about",
    "services",
    "features",
    "stats",
    "testimonials",
    "gallery",
    "team",
    "faq",
    "cta",
    "contact",
    "logos",
    "rich_text",
    "process",
    "listings",
    "listing_categories"
  ],
  "page_types": {
    "home": {
      "default_sections": [
        "hero",
        "listing_categories",
        "listings",
        "about",
        "stats",
        "services",
        "listings",
        "testimonials",
        "logos",
        "cta"
      ]
    },
    "about": {
      "default_sections": [
        "page_banner",
        "about",
        "stats",
        "features",
        "team"
      ]
    },
    "services": {
      "default_sections": [
        "page_banner",
        "services",
        "process",
        "faq",
        "cta"
      ]
    },
    "team": {
      "default_sections": [
        "page_banner",
        "team",
        "testimonials",
        "cta"
      ]
    },
    "contact": {
      "default_sections": [
        "page_banner",
        "contact"
      ]
    },
    "legal": {
      "default_sections": [
        "page_banner",
        "rich_text"
      ]
    },
    "generic": {
      "default_sections": [
        "page_banner",
        "rich_text",
        "cta"
      ]
    }
  },
  "default_pages": [
    {
      "title": "Home",
      "slug": "",
      "type": "home",
      "is_home": true
    },
    {
      "title": "About",
      "slug": "about",
      "type": "about"
    },
    {
      "title": "Services",
      "slug": "services",
      "type": "services"
    },
    {
      "title": "Team",
      "slug": "team",
      "type": "team"
    },
    {
      "title": "Contact",
      "slug": "contact",
      "type": "contact"
    },
    {
      "title": "Privacy Policy",
      "slug": "privacy-policy",
      "type": "legal",
      "in_menu": false,
      "in_footer": true
    },
    {
      "title": "Terms and Conditions",
      "slug": "terms-and-conditions",
      "type": "legal",
      "in_menu": false,
      "in_footer": true
    },
    {
      "title": "Disclaimer",
      "slug": "disclaimer",
      "type": "legal",
      "in_menu": false,
      "in_footer": true
    }
  ],
  "listings": {
    "path": "properties",
    "singular": "Home",
    "plural": "Homes",
    "menu_label": "Homes for rent",
    "icon": "bi-buildings",
    "category_label": "Home type",
    "location_label": "Locality",
    "price_label": "Rent",
    "price_format": "lakh",
    "price_notes": [
      "onwards",
      "per month",
      "per night",
      "per acre",
      "negotiable",
      "all inclusive"
    ],
    "closed_label": "Let out",
    "attributes": [
      {
        "key": "listing_for",
        "label": "Available for",
        "type": "select",
        "options": [
          "Rent",
          "Sale"
        ],
        "filter": true,
        "icon": "bi-tag"
      },
      {
        "key": "bedrooms",
        "label": "Bedrooms",
        "type": "number",
        "suffix": "BHK",
        "filter": true,
        "card": true,
        "icon": "bi-door-closed"
      },
      {
        "key": "bathrooms",
        "label": "Bathrooms",
        "type": "number",
        "suffix": "Baths",
        "card": true,
        "icon": "bi-droplet"
      },
      {
        "key": "area",
        "label": "Built-up area",
        "type": "number",
        "suffix": "sq ft",
        "card": true,
        "icon": "bi-bounding-box"
      },
      {
        "key": "furnishing",
        "label": "Furnishing",
        "type": "select",
        "options": [
          "Unfurnished",
          "Semi-furnished",
          "Fully furnished"
        ],
        "filter": true,
        "icon": "bi-lamp"
      },
      {
        "key": "tenants",
        "label": "Preferred tenants",
        "type": "select",
        "options": [
          "Family",
          "Bachelors",
          "Company lease",
          "Anyone"
        ],
        "filter": true,
        "icon": "bi-people"
      },
      {
        "key": "deposit",
        "label": "Security deposit",
        "type": "text",
        "icon": "bi-safe"
      },
      {
        "key": "floor",
        "label": "Floor",
        "type": "text",
        "icon": "bi-layers",
        "help": "e.g. 7th of 14"
      },
      {
        "key": "parking",
        "label": "Car parking",
        "type": "number",
        "icon": "bi-p-circle"
      },
      {
        "key": "amenities",
        "label": "Amenities",
        "type": "list",
        "icon": "bi-stars"
      },
      {
        "key": "nearby",
        "label": "Nearby",
        "type": "list",
        "icon": "bi-geo"
      }
    ],
    "enquiry": {
      "heading": "Schedule a viewing",
      "button": "Book a viewing",
      "date_label": "Preferred viewing date",
      "select_label": "Moving in",
      "select_options": [
        "Within 2 weeks",
        "Within a month",
        "In 1–3 months",
        "Just looking"
      ],
      "success": "Thank you! A HomeHive manager will call you to fix the viewing."
    }
  }
}
