{
  "id": "realestate_template_01",
  "name": "Keystone Realty",
  "category": "real-estate",
  "version": "1.0.0",
  "description": "A confident, premium design for builders, brokers and property consultants: burgundy and champagne on warm stone, Sora headings and crisp architectural lines. Includes a property search in the hero, a filterable property portal (buy or rent, type, locality, budget, bedrooms), property pages with photo gallery, specifications, amenities and a site-visit enquiry form, plus agents, home-loan partners and a buying process timeline.",
  "libraries": ["bootstrap", "bootstrap-icons"],
  "features": ["contact"],
  "optional_features": ["payments"],
  "theme": {
    "defaults": {
      "primary": "#7A2E3A", "secondary": "#D8B26E", "bg": "#F7F5F2", "text": "#1E1B1C",
      "heading_font": "sora", "body_font": "dm-sans", "radius": "6px",
      "button_style": "sharp", "header_style": "topbar", "footer_style": "dark"
    },
    "header_styles": { "topbar": "With contact bar", "minimal": "Minimal, no bar" },
    "footer_styles": { "dark": "Dark", "light": "Light stone" }
  },
  "listings": {
    "path": "properties",
    "singular": "Property",
    "plural": "Properties",
    "icon": "bi-buildings",
    "category_label": "Property type",
    "location_label": "Locality",
    "price_label": "Price",
    "price_format": "lakh",
    "price_notes": ["onwards", "per month", "negotiable", "all inclusive"],
    "closed_label": "Sold",
    "attributes": [
      { "key": "listing_for", "label": "Available for", "type": "select", "options": ["Sale", "Rent"], "filter": true, "icon": "bi-tag" },
      { "key": "bedrooms", "label": "Bedrooms", "type": "number", "suffix": "BHK", "filter": true, "card": true, "icon": "bi-door-closed" },
      { "key": "bathrooms", "label": "Bathrooms", "type": "number", "suffix": "Baths", "card": true, "icon": "bi-droplet" },
      { "key": "area", "label": "Built-up area", "type": "number", "suffix": "sq ft", "card": true, "icon": "bi-bounding-box" },
      { "key": "possession", "label": "Possession", "type": "select", "options": ["Ready to move", "Under construction", "New launch"], "filter": true, "icon": "bi-calendar-check" },
      { "key": "furnishing", "label": "Furnishing", "type": "select", "options": ["Unfurnished", "Semi-furnished", "Fully furnished"], "icon": "bi-lamp" },
      { "key": "facing", "label": "Facing", "type": "select", "options": ["East", "West", "North", "South", "North-East", "North-West", "South-East", "South-West"], "icon": "bi-compass" },
      { "key": "floor", "label": "Floor", "type": "text", "icon": "bi-layers", "help": "e.g. 7th of 14" },
      { "key": "parking", "label": "Car parking", "type": "number", "icon": "bi-p-circle" },
      { "key": "rera", "label": "RERA number", "type": "text", "icon": "bi-patch-check", "help": "Shown on the property page; required for projects registered under RERA." },
      { "key": "amenities", "label": "Amenities", "type": "list", "icon": "bi-stars" },
      { "key": "nearby", "label": "Nearby", "type": "list", "icon": "bi-geo" }
    ],
    "enquiry": {
      "heading": "Schedule a site visit",
      "button": "Request a visit",
      "date_label": "Preferred visit date",
      "select_label": "I am",
      "select_options": ["Looking to buy", "Looking to rent", "An investor", "Just exploring"],
      "message_label": "Anything we should know? (optional)",
      "success": "Thank you! Our property advisor will call you within one working day to confirm the visit."
    }
  },
  "section_types": ["hero", "page_banner", "about", "services", "features", "stats", "testimonials", "gallery", "team", "faq", "cta", "contact", "logos", "rich_text", "process", "listings", "listing_categories"],
  "page_types": {
    "home": { "default_sections": ["hero", "listing_categories", "listings", "about", "stats", "services", "listings", "testimonials", "logos", "cta"] },
    "about": { "default_sections": ["page_banner", "about", "stats", "team", "features"] },
    "services": { "default_sections": ["page_banner", "services", "process", "faq", "cta"] },
    "agents": { "default_sections": ["page_banner", "team", "testimonials", "cta"] },
    "contact": { "default_sections": ["page_banner", "contact"] },
    "legal": { "default_sections": ["page_banner", "rich_text"] },
    "generic": { "default_sections": ["page_banner", "rich_text", "cta"] }
  },
  "default_pages": [
    { "title": "Home", "slug": "", "type": "home", "is_home": true },
    { "title": "About Us", "slug": "about", "type": "about" },
    { "title": "Services", "slug": "services", "type": "services" },
    { "title": "Our Agents", "slug": "agents", "type": "agents" },
    { "title": "Contact", "slug": "contact", "type": "contact" },
    { "title": "Privacy Policy", "slug": "privacy-policy", "type": "legal", "in_menu": false, "in_footer": true },
    { "title": "Terms and Conditions", "slug": "terms-and-conditions", "type": "legal", "in_menu": false, "in_footer": true },
    { "title": "Disclaimer", "slug": "disclaimer", "type": "legal", "in_menu": false, "in_footer": true }
  ],
  "demo_content": "demo.json"
}
