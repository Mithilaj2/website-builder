        "filter": true,
        "card": true,
        "icon": "bi-compass"
      },
      {
        "key": "region",
        "label": "Region",
        "type": "select",
        "options": [
          "Central India",
          "North India",
          "North-east",
          "Africa"
        ],
        "filter": true,
        "icon": "bi-globe2"
      },
      {
        "key": "group_size",
        "label": "Jeep",
        "type": "text",
        "card": true,
        "icon": "bi-people",
        "help": "e.g. Max 12 or Private"
      },
      {
        "key": "best_time",
        "label": "Best time to go",
        "type": "text",
        "icon": "bi-sun",
        "help": "e.g. Oct – Mar"
      },
      {
        "key": "start_city",
        "label": "Starts from",
        "type": "text",
        "icon": "bi-geo-alt"
      },
      {
        "key": "flights",
        "label": "Flights included",
        "type": "toggle",
        "filter": true,
        "icon": "bi-airplane"
      },
      {
        "key": "highlights",
        "label": "Highlights",
        "type": "list",
        "icon": "bi-stars"
      },
      {
        "key": "inclusions",
        "label": "What’s included",
        "type": "list",
        "icon": "bi-check-circle"
      },
      {
        "key": "exclusions",
        "label": "Not included",
        "type": "list",
        "icon": "bi-x-circle"
      }
