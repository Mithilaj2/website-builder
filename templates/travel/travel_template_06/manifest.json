    "enquiry": {
      "heading": "Plan my safari",
      "button": "Send enquiry",
      "date_label": "Safari start date",
      "select_label": "Travellers",
      "select_options": [
        "2 travellers",
        "3–4 travellers",
        "5–6 travellers",
        "Photography group"
      ],
      "message_label": "Anything else? (hotel preference, special requests)",
      "success": "Thank you! A naturalist will call you about the best zones and dates."
    }
