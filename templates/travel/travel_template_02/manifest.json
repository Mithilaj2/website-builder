{
  "id": "travel_template_02",
  "name": "Coral & Co. Honeymoons",
  "category": "travel",
  "version": "1.0.0",
  "description": "A romantic, airy design for honeymoon and luxury travel planners: centred masthead, a full-bleed hero with a trip search, image destination tiles, cards with the price on the photo and a featured couple story.",
  "libraries": [
    "bootstrap",
    "bootstrap-icons"
  ],
  "features": [
    "contact"
  ],
  "optional_features": [
    "payments"
  ],
  "theme": {
    "defaults": {
      "primary": "#0F5C6E",
      "secondary": "#F26B5B",
      "bg": "#FFF9F6",
      "text": "#1C2A30",
      "heading_font": "dm-serif-display",
      "body_font": "dm-sans",
      "radius": "22px",
      "button_style": "pill",
      "header_style": "sticky",
      "footer_style": "dark"
    },
    "header_styles": {
      "sticky": "Sticky",
      "static": "Scrolls with the page"
    },
    "footer_styles": {
      "dark": "Dark",
      "light": "Light"
    }
  },
  "section_types": [
    "hero",
    "page_banner",
    "about",
    "services",
    "features",
    "stats",
    "testimonials",
    "gallery",
    "team",
    "faq",
    "cta",
    "contact",
    "logos",
    "rich_text",
    "process",
    "listings",
    "listing_categories"
  ],
  "page_types": {
    "home": {
      "default_sections": [
        "hero",
        "listing_categories",
        "listings",
        "features",
        "stats",
        "listings",
        "gallery",
        "testimonials",
        "cta"
      ]
    },
    "about": {
      "default_sections": [
        "page_banner",
        "about",
        "stats",
        "team",
        "logos"
      ]
    },
    "services": {
      "default_sections": [
        "page_banner",
        "services",
        "process",
        "faq",
        "cta"
      ]
    },
    "contact": {
      "default_sections": [
        "page_banner",
        "contact"
      ]
    },
    "legal": {
      "default_sections": [
        "page_banner",
        "rich_text"
      ]
    },
    "generic": {
      "default_sections": [
        "page_banner",
        "rich_text",
        "cta"
      ]
    }
  },
  "default_pages": [
    {
      "title": "Home",
      "slug": "",
      "type": "home",
      "is_home": true
    },
    {
      "title": "About",
      "slug": "about",
      "type": "about"
    },
    {
      "title": "Services",
      "slug": "services",
      "type": "services"
    },
    {
      "title": "Contact",
      "slug": "contact",
      "type": "contact"
    },
    {
      "title": "Privacy Policy",
      "slug": "privacy-policy",
      "type": "legal",
      "in_menu": false,
      "in_footer": true
    },
    {
      "title": "Terms and Conditions",
      "slug": "terms-and-conditions",
      "type": "legal",
      "in_menu": false,
      "in_footer": true
    },
    {
      "title": "Cancellation Policy",
      "slug": "cancellation-policy",
      "type": "legal",
      "in_menu": false,
      "in_footer": true
    }
  ],
  "listings": {
    "path": "packages",
    "singular": "Package",
    "plural": "Honeymoons",
    "menu_label": "Honeymoons",
    "icon": "bi-airplane",
    "category_label": "Destination",
    "location_label": "Route",
    "location_filter": false,
    "price_label": "Price",
    "price_format": "inr",
    "price_notes": [
      "per person",
      "per couple",
      "per person, twin sharing",
      "per student",
      "onwards"
    ],
    "closed_label": "Sold out",
    "attributes": [
      {
        "key": "duration",
        "label": "Duration",
        "type": "number",
        "suffix": "Days",
        "filter": true,
        "card": true,
        "icon": "bi-calendar3"
      },
      {
        "key": "nights",
        "label": "Nights",
        "type": "number",
        "suffix": "Nights",
        "icon": "bi-moon-stars"
      },
      {
        "key": "trip_type",
        "label": "Trip type",
        "type": "select",
        "options": [
          "Beach",
          "Mountains",
          "Island",
          "City & culture",
          "Luxury"
        ],
        "filter": true,
        "card": true,
        "icon": "bi-compass"
      },
      {
        "key": "region",
        "label": "Region",
        "type": "select",
        "options": [
          "India",
          "International"
        ],
        "filter": true,
        "icon": "bi-globe2"
      },
      {
        "key": "group_size",
        "label": "Room type",
        "type": "text",
        "card": true,
        "icon": "bi-people",
        "help": "e.g. Max 12 or Private"
      },
      {
        "key": "best_time",
        "label": "Best time to go",
        "type": "text",
        "icon": "bi-sun",
        "help": "e.g. Oct – Mar"
      },
      {
        "key": "start_city",
        "label": "Starts from",
        "type": "text",
        "icon": "bi-geo-alt"
      },
      {
        "key": "flights",
        "label": "Flights included",
        "type": "toggle",
        "filter": true,
        "icon": "bi-airplane"
      },
      {
        "key": "highlights",
        "label": "Highlights",
        "type": "list",
        "icon": "bi-stars"
      },
      {
        "key": "inclusions",
        "label": "What’s included",
        "type": "list",
        "icon": "bi-check-circle"
      },
      {
        "key": "exclusions",
        "label": "Not included",
        "type": "list",
        "icon": "bi-x-circle"
      }
    ],
    "enquiry": {
      "heading": "Plan our honeymoon",
      "button": "Send enquiry",
      "date_label": "Wedding date",
      "select_label": "Budget per couple",
      "select_options": [
        "Under ₹1 lakh",
        "₹1–2 lakh",
        "₹2–4 lakh",
        "Above ₹4 lakh"
      ],
      "message_label": "Anything else? (hotel preference, special requests)",
      "success": "Thank you! Your honeymoon planner will call you within a few hours with ideas and a quote."
    }
  }
}
