    "privacy-policy": {
      "seo_title": "",
      "sections": [
        {
          "type": "page_banner",
          "data": {
            "heading": "Privacy Policy",
            "subheading": "",
            "background_image": "theme:images/banner.svg"
          }
        },
        {
          "type": "rich_text",
          "data": {
            "heading": "",
            "width": "narrow",
            "content": "<p>This policy explains how Wanderwise Group Tours collects and uses the personal information you share through this website.</p><h3>Information we collect</h3><p>Your name, phone number, email address, travel dates and preferences when you send an enquiry or book a trip. For bookings we also collect traveller names and, where needed, passport details.</p><h3>How we use it</h3><p>Only to plan and book your trip, and to share it with hotels, airlines and transport partners who need it to provide your services. We never sell your data.</p><h3>Your choices</h3><p>Write to us to correct or delete your information at any time.</p>"
          }
        }
      ]
    },
    "terms-and-conditions": {
      "seo_title": "",
      "sections": [
        {
          "type": "page_banner",
          "data": {
            "heading": "Terms and Conditions",
            "subheading": "",
            "background_image": "theme:images/banner.svg"
          }
        },
        {
          "type": "rich_text",
          "data": {
            "heading": "",
            "width": "narrow",
            "content": "<h3>Bookings</h3><p>A booking is confirmed when we receive the advance payment and send a confirmation. Prices are subject to availability and may change until confirmation.</p><h3>Payments</h3><p>A 25% advance confirms the booking; the balance is due 21 days before departure.</p><h3>Changes</h3><p>Hotel or route changes after confirmation may cost extra. We are not responsible for delays caused by weather, strikes or other events beyond our control.</p>"
          }
        }
      ]
    },
    "cancellation-policy": {
      "seo_title": "",
      "sections": [
        {
          "type": "page_banner",
          "data": {
            "heading": "Cancellation Policy",
            "subheading": "",
            "background_image": "theme:images/banner.svg"
          }
        },
        {
          "type": "rich_text",
          "data": {
            "heading": "",
            "width": "narrow",
            "content": "<ul><li>30 days or more before departure: full refund minus ₹2,500 per person.</li><li>15–29 days before departure: 50% of the package price is refunded.</li><li>Less than 15 days before departure: no refund.</li></ul><p>Flight tickets, visas and non-refundable hotel bookings are refunded according to the supplier’s rules.</p>"
          }
        }
