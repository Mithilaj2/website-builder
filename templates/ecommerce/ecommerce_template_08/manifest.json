{
  "id": "ecommerce_template_08",
  "name": "Estate Roast",
  "category": "ecommerce",
  "version": "1.0.0",
  "description": "A warm, artisanal design for coffee, tea, bakery and specialty-food stores: dark navigation with cart, a full-bleed hero, image category tiles, product cards with hover quick-add and a numbers band.",
  "libraries": [
    "bootstrap",
    "bootstrap-icons"
  ],
  "features": [
    "contact",
    "ecommerce"
  ],
  "optional_features": [
    "payments"
  ],
  "theme": {
    "defaults": {
      "primary": "#3B2A20",
      "secondary": "#C97B2E",
      "bg": "#F6F1EA",
      "text": "#2A1E17",
      "heading_font": "merriweather",
      "body_font": "inter",
      "radius": "6px",
      "button_style": "solid",
      "header_style": "announce",
      "footer_style": "dark"
    },
    "header_styles": {
      "announce": "With announcement bar",
      "minimal": "No announcement bar"
    },
    "footer_styles": {
      "dark": "Dark",
      "light": "Light"
    }
  },
  "section_types": [
    "hero",
    "page_banner",
    "about",
    "features",
    "stats",
    "testimonials",
    "gallery",
    "faq",
    "cta",
    "contact",
    "logos",
    "rich_text",
    "products",
    "product_categories"
  ],
  "page_types": {
    "home": {
      "default_sections": [
        "hero",
        "product_categories",
        "products",
        "about",
        "stats",
        "products",
        "testimonials",
        "cta"
      ]
    },
    "about": {
      "default_sections": [
        "page_banner",
        "about",
        "stats",
        "gallery"
      ]
    },
    "help": {
      "default_sections": [
        "page_banner",
        "faq",
        "cta"
      ]
    },
    "contact": {
      "default_sections": [
        "page_banner",
        "contact"
      ]
    },
    "legal": {
      "default_sections": [
        "page_banner",
        "rich_text"
      ]
    },
    "generic": {
      "default_sections": [
        "page_banner",
        "rich_text",
        "cta"
      ]
    }
  },
  "default_pages": [
    {
      "title": "Home",
      "slug": "",
      "type": "home",
      "is_home": true
    },
    {
      "title": "Our Story",
      "slug": "about",
      "type": "about"
    },
    {
