        {
          "type": "rich_text",
          "data": {
            "heading": "",
            "content": "<h2>Delivery</h2><p>Ships in 1–2 days; delivered in 2–5 working days.</p><ul><li>Delivery is free on orders above ₹799; otherwise a flat ₹59 applies.</li><li>Cash on delivery is available for a ₹39 handling fee.</li><li>You will receive tracking details by email and SMS once your order ships.</li></ul><h2>Returns</h2><p>Unopened products can be returned within 7 days.</p><p>To start a return, email care@dewandpetal.example with your order number. Refunds are made to the original payment method within 5–7 working days of receiving the item.</p>",
            "width": "narrow"
          }
        }
      ]
