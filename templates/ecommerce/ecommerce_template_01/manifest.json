{
  "id": "ecommerce_template_01",
  "name": "Terra Market",
  "category": "ecommerce",
  "version": "1.0.0",
  "description": "A warm, editorial online store for handmade and lifestyle brands: terracotta and sage on cream, Playfair Display headings, soft pill-shaped frames and a scrolling announcement bar. Full shop: categories, product pages with options, cart, coupons, GST-ready checkout (online payment or cash on delivery), order tracking and PDF invoices.",
  "libraries": ["bootstrap", "bootstrap-icons"],
  "features": ["contact", "ecommerce"],
  "optional_features": ["payments"],
  "theme": {
    "defaults": {
      "primary": "#B5543A", "secondary": "#6E8B74", "bg": "#FAF6F1", "text": "#1F1A17",
      "heading_font": "playfair-display", "body_font": "inter", "radius": "8px",
      "button_style": "pill", "header_style": "announce", "footer_style": "dark"
    },
    "header_styles": { "announce": "With announcement bar", "minimal": "Minimal, no bar" },
    "footer_styles": { "dark": "Dark", "light": "Light" }
  },
  "section_types": ["hero", "page_banner", "about", "features", "stats", "testimonials", "gallery", "faq", "cta", "contact", "logos", "rich_text", "products", "product_categories"],
  "page_types": {
    "home": { "default_sections": ["hero", "product_categories", "products", "features", "about", "products", "testimonials", "cta"] },
    "about": { "default_sections": ["page_banner", "about", "stats", "gallery", "testimonials"] },
    "help": { "default_sections": ["page_banner", "faq", "cta"] },
    "contact": { "default_sections": ["page_banner", "contact"] },
    "legal": { "default_sections": ["page_banner", "rich_text"] },
    "generic": { "default_sections": ["page_banner", "rich_text", "products"] }
  },
  "default_pages": [
    { "title": "Home", "slug": "", "type": "home", "is_home": true },
    { "title": "Our Story", "slug": "about", "type": "about" },
    { "title": "Help & FAQ", "slug": "help", "type": "help" },
    { "title": "Contact", "slug": "contact", "type": "contact" },
    { "title": "Shipping & Returns", "slug": "shipping-returns", "type": "legal", "in_menu": false, "in_footer": true },
    { "title": "Privacy Policy", "slug": "privacy-policy", "type": "legal", "in_menu": false, "in_footer": true },
    { "title": "Terms and Conditions", "slug": "terms-and-conditions", "type": "legal", "in_menu": false, "in_footer": true }
  ],
  "demo_content": "demo.json"
}
