    "shipping-returns": {
      "sections": [
        {
          "type": "page_banner",
          "data": {
            "heading": "Shipping & Returns",
            "subheading": "How we deliver, and how returns work.",
            "background_image": ""
          }
        },
        {
          "type": "rich_text",
          "data": {
            "heading": "",
            "content": "<h2>Delivery</h2><p>Ships the same day before 3 pm; next-day delivery in metros.</p><ul><li>Delivery is free on orders above ₹999; otherwise a flat ₹79 applies.</li><li>Cash on delivery is available for a ₹59 handling fee.</li><li>You will receive tracking details by email and SMS once your order ships.</li></ul><h2>Returns</h2><p>7-day replacement for manufacturing defects.</p><p>To start a return, email support@voltbay.example with your order number. Refunds are made to the original payment method within 5–7 working days of receiving the item.</p>",
            "width": "narrow"
          }
        }
      ]
    },
    "privacy-policy": {
      "sections": [
        {
          "type": "page_banner",
          "data": {
            "heading": "Privacy Policy",
            "subheading": ""
          }
        },
        {
          "type": "rich_text",
          "data": {
            "heading": "",
            "width": "narrow",
            "content": "<p>This policy explains how Voltbay collects and uses your information.</p><h3>What we collect</h3><p>When you order, we collect your name, email, phone number and delivery address so we can process and deliver your order. Payments are handled by our payment partner; we never see or store your card details.</p><h3>How we use it</h3><p>Only to fulfil your orders, send order updates and answer your questions. We do not sell your information.</p><h3>Contact</h3><p>For any privacy question, contact us using the details on the contact page.</p>"
          }
        }
      ]
