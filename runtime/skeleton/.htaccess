# Channel Softech Website Builder — generated website
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Private folders and template source files are never served.
    RewriteRule ^(config|core|vendor|storage|database)(/|$) - [F,L]
    RewriteRule ^theme/(layouts|partials|sections)(/|$) - [F,L]
    RewriteRule ^theme/[^/]+\.(json|php)$ - [F,L]
    # Everything that is not a real file goes to the front controller (clean URLs).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<FilesMatch "(?i)\.(sql|log|lock|md|ini|env|bak)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
